# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=changeme_app
MYSQL_PORT=3306
# Para restringir acceso a localhost: MYSQL_PORT=127.0.0.1:3306

# phpMyAdmin
PMA_HOST=mysql
PMA_PORT=3306
PMA_HOST_PORT=8080
# Para restringir acceso a localhost: PMA_HOST_PORT=127.0.0.1:8080
UPLOAD_LIMIT=128M
MEMORY_LIMIT=512M
MAX_EXECUTION_TIME=600

# Redis
REDIS_PORT=6379
# Para restringir acceso a localhost: REDIS_PORT=127.0.0.1:6379
